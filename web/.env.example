# EpisodeKit web — env vars for WP-02 (DB + auth + show).
# Copy to .env.local for local dev. Never commit real values.

# Neon Postgres connection string (Vercel Marketplace → Neon).
# Without it, DB-backed routes answer 503 and app shells render empty.
DATABASE_URL=

# Clerk (Vercel Marketplace → Clerk; dashboard.clerk.com).
# Publishable key (pk_…) — safe for the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key (sk_…) — server only.
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Clerk dashboard → Webhooks → your endpoint;
# svix format, starts with whsec_). Verifies POST /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk routing (defaults shown; used by ClerkProvider and the sign-in/up pages)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
