# EpisodeKit web — env vars for WP-02 (DB + auth + show).
# Copy to .env.local for local dev. Never commit real values.

# Neon Postgres connection string (Vercel Marketplace → Neon).
# Without it, DB-backed routes answer 503 and app shells render empty.
DATABASE_URL=

# Clerk (Vercel Marketplace → Clerk; dashboard.clerk.com).
# Publishable key (pk_…) — safe for the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key (sk_…) — server only.
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Clerk dashboard → Webhooks → your endpoint;
# svix format, starts with whsec_). Verifies POST /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk routing (defaults shown; used by ClerkProvider and the sign-in/up pages)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- WP-05 (intake + ASR) ---
# Vercel Blob read-write token (Vercel → Storage → Blob). NOT configured yet —
# owner blocker: audio upload and playback answer 503 until it is set.
BLOB_READ_WRITE_TOKEN=

# Groq (ASR + fallback LLM). ASR adapter uses GROQ_API_KEY (or ASR_API_KEY).
GROQ_API_KEY=

# ── Lemon Squeezy (WP-08 billing; §9). Owner blocker until the store is live
# (docs/FOR-ABID.md §1) — everything degrades to preview copy when unset.
# API key (dashboard.lemonsqueezy.com → Settings → API keys). Server only.
LS_API_KEY=
# Store id (number, from the LS dashboard URL or API).
LS_STORE_ID=
# Webhook signing secret (Settings → Webhooks; 6–40 chars). Verifies the
# X-Signature HMAC of POST /api/webhooks/lemonsqueezy.
LS_WEBHOOK_SECRET=
# Variant id of the "Pro $19/month" subscription.
LS_VARIANT_PRO_MONTHLY=
# Variant id of the "Founding Pro $99/yr" product (first 100).
LS_VARIANT_FOUNDING=
# Optional fallback when the LS store is NOT live (§0.2 manual flow): the
# Founding Pro payment link (https://<store>.lemonsqueezy.com/buy/<uuid>).
# The purchase only becomes Pro after the owner flags it in /admin.
LS_FOUNDING_PAYMENT_URL=

# Owner emails for /admin (comma-separated; M13). Gates the manual plan flag.
OWNER_EMAILS=
